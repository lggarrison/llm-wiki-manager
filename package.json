{
  "name": "llm-wiki-manager",
  "version": "1.0.0",
  "description": "Scaffold and manage an LLM-maintained personal wiki",
  "type": "module",
  "bin": {
    "llm-wiki-manager": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lggarrison/llm-wiki-manager.git"
  },
  "homepage": "https://github.com/lggarrison/llm-wiki-manager#readme",
  "bugs": {
    "url": "https://github.com/lggarrison/llm-wiki-manager/issues"
  },
  "author": "lggarrison",
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "check-node-types": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "node .husky/install.mjs && npm run build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:node-types": "check-node-types --source nvmrc",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "release:check": "run-s check:node-types lint format:check test build test:e2e wiki:lint wiki:check",
    "wiki:help": "node dist/bin/cli.js help",
    "wiki:lint": "node dist/bin/cli.js lint",
    "wiki:build": "node dist/bin/cli.js build",
    "wiki:check": "node dist/bin/cli.js check",
    "wiki:sync": "node dist/bin/cli.js sync",
    "wiki:log": "node dist/bin/cli.js log",
    "wiki:setup:husky": "node dist/bin/cli.js setup-husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "wiki/**/*.md": [
      "npm run wiki:build",
      "npm run wiki:lint",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "wiki",
    "llm",
    "ai",
    "knowledge-base",
    "scaffold",
    "agents"
  ],
  "license": "MIT"
}
