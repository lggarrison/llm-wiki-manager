{
  "name": "llm-wiki-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffold and manage an LLM-maintained personal wiki",
  "type": "module",
  "bin": {
    "llm-wiki-manager": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lggarrison/llm-wiki-manager.git"
  },
  "homepage": "https://github.com/lggarrison/llm-wiki-manager#readme",
  "bugs": {
    "url": "https://github.com/lggarrison/llm-wiki-manager/issues"
  },
  "author": "lggarrison",
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "node .husky/install.mjs && npm run build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "release:check": "npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e && npm run wiki:lint && npm run wiki:check",
    "wiki:help": "node scripts/wiki/help.mjs",
    "wiki:lint": "node scripts/wiki/lint.mjs",
    "wiki:build": "node scripts/wiki/build-index.mjs",
    "wiki:check": "node scripts/wiki/build-index.mjs --check",
    "wiki:sync": "node scripts/wiki/sync-see-also.mjs",
    "wiki:log": "node scripts/wiki/log.mjs",
    "wiki:setup:husky": "node scripts/wiki/setup-husky.mjs"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "wiki/**/*.md": [
      "npm run wiki:build",
      "npm run wiki:lint",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [
    "wiki",
    "llm",
    "ai",
    "knowledge-base",
    "scaffold",
    "agents"
  ],
  "license": "MIT"
}
