    "llm-wiki-manager": "./dist/bin/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lggarrison/llm-wiki-manager.git"
  },
  "homepage": "https://github.com/lggarrison/llm-wiki-manager#readme",
  "bugs": {
    "url": "https://github.com/lggarrison/llm-wiki-manager/issues"
  },
  "author": "lggarrison",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
